# ========================================
# Configuração da IA (opcional)
# Copie este arquivo para ".env" e preencha.
# A chave também pode ser inserida pela interface
# (ícone de engrenagem no assistente), que é
# salva no localStorage do navegador.
# ========================================

# Chave de API (OpenAI ou qualquer API compatível com /chat/completions)
VITE_AI_API_KEY=

# URL base da API. Padrão: OpenAI.
# Para OpenRouter use: https://openrouter.ai/api/v1
VITE_AI_BASE_URL=https://api.openai.com/v1

# Modelo usado. Padrões: gpt-4o-mini (OpenAI) | openai/gpt-4o-mini (OpenRouter)
VITE_AI_MODEL=gpt-4o-mini
