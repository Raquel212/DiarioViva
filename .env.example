# ========================================
# Configuração da IA (opcional)
# Copie este arquivo para ".env" e preencha.
# A chave também pode ser inserida pela interface
# (ícone de engrenagem no assistente), que é
# salva no localStorage do navegador.
# ========================================

# Chave de API (OpenAI, OpenRouter, Google Gemini...)
#
# Para usar o Google GEMINI:
#   VITE_AI_API_KEY=SUA_CHAVE_GEMINI
#   VITE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   VITE_AI_MODEL=gemini-2.5-flash
#
# Para usar a OpenAI (padrão):
#   VITE_AI_API_KEY=sk-...
#   VITE_AI_BASE_URL=https://api.openai.com/v1
#   VITE_AI_MODEL=gpt-4o-mini
#
# Para usar o OpenRouter:
#   VITE_AI_API_KEY=sk-or-...
#   VITE_AI_BASE_URL=https://openrouter.ai/api/v1
#   VITE_AI_MODEL=openai/gpt-4o-mini
# ========================================
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.openai.com/v1
VITE_AI_MODEL=gpt-4o-mini
